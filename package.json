{
    "private": true,
    "scripts": {
        "verify": "pnpm fix && pnpm check:deps && pnpm docs:build",
        "verify:full": "pnpm verify && pnpm test:accessibility",
        "build:types": "pnpm --filter @nu-appdev/northwestern-starlight-theme build",
        "fix": "biome check --write && stylelint \"packages/northwestern-starlight-theme/src/**/*.css\" --fix",
        "check": "biome check",
        "check:deps": "knip",
        "docs:build": "pnpm --filter docs build",
        "docs:dev": "pnpm --filter docs dev",
        "docs:preview": "pnpm --filter docs preview",
        "lint:css": "stylelint \"packages/northwestern-starlight-theme/src/**/*.css\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:consumer-types": "pnpm build:types && pnpm --filter @nu-appdev/northwestern-starlight-theme exec tsc --project ../../tests/consumer-types/tsconfig.json --noEmit",
        "test:e2e": "playwright test",
        "test:links-validation": "node tests/build/links-validation.mjs",
        "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
        "test:mermaid": "playwright test tests/e2e/mermaid-toolbar.spec.ts",
        "test:theme": "playwright test tests/e2e/theme-toggle.spec.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@biomejs/biome": "^2.5.9",
        "@playwright/test": "^1.62.1",
        "knip": "^6.32.2",
        "playwright": "^1.62.1",
        "stylelint": "^17.14.1",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.1",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": ">= 22.0.0",
        "npm": "please-use-pnpm",
        "pnpm": ">= 10.0.0",
        "yarn": "please-use-pnpm"
    }
}
